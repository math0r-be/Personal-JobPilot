generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default("local")
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  location  String   @default("")
  summary     String  @default("")
  photoUrl    String  @default("")
  portfolioUrl String @default("")
  locale      String  @default("fr-FR")
  targetRoles  String @default("[]")
  targetSalary String @default("")
  dealBreakers String @default("[]")
  narrative    String @default("")
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiConfig {
  id        String   @id @default("active")
  provider  String   @default("openrouter")
  apiKey    String   @default("")
  baseUrl   String   @default("")
  model     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmtpConfig {
  id        String   @id @default("active")
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @default("")
  pass      String   @default("")
  fromName  String   @default("")
  fromEmail String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cv {
  id            String         @id @default(cuid())
  title         String         @default("Mon CV")
  content       String         @default("{}")
  photo         String         @default("")
  templateId    String         @default("classic")
  jobPostingId  String?
  jobPosting    JobPosting?    @relation(fields: [jobPostingId], references: [id])
  coverLetters  CoverLetter[]
  matchScore    Int?
  isReference    Boolean       @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CoverLetter {
  id           String      @id @default(cuid())
  title        String      @default("Lettre de motivation")
  body         String
  cvId         String
  cv           Cv          @relation(fields: [cvId], references: [id], onDelete: Cascade)
  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model JobPosting {
  id           String         @id @default(cuid())
  title        String        @default("")
  company      String        @default("")
  location     String        @default("")
  rawText      String
  parsedData   String        @default("{}")
  status       String        @default("new")
  score        Float?
  evaluation   String        @default("{}")
  archetype    String?
  legitimacy   String?
  dealBreakers String?
  cvs          Cv[]
  coverLetters CoverLetter[]
  emails       Email[]
  notes        String        @default("")
  appliedAt    DateTime?
  url          String        @default("")
  source       String?
  salary       String?
  followUpDate DateTime?
  lastFollowUpAt DateTime?
  followUpCount Int     @default(0)
  activities   ActivityLog[]
  stories      Story[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([score])
  @@index([archetype])
  @@index([followUpDate])
  @@index([createdAt])
}

model ActivityLog {
  id          String     @id @default(cuid())
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime   @default(now())

  @@index([jobId])
}

model Email {
  id           String      @id @default(cuid())
  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id])
  to           String
  subject      String
  body         String
  status       String      @default("draft")
  sentAt       DateTime?
  errorMsg     String?
  createdAt    DateTime    @default(now())

  @@index([jobPostingId])
  @@index([sentAt])
}

model Story {
  id          String      @id @default(cuid())
  theme       String
  title       String
  situation   String
  task        String
  action      String
  result      String
  reflection  String?
  bestFor     String      @default("")
  sourceJobId String?
  sourceJob   JobPosting? @relation(fields: [sourceJobId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([theme])
}

// Content style analysis models

model ContentImport {
  id               String   @id @default(cuid())
  type             String   @default("other") // email | cover_letter | other
  source           String   @default("paste") // file | paste
  originalFilename String?
  rawText          String
  language         String   @default("unknown") // fr | en | unknown
  wordCount        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([type])
  @@index([language])
}

model StyleProfile {
  id              String   @id @default(cuid())
  language        String   // fr | en | global
  // Tone (stored as JSON string)
  toneJson        String   @default("{}")
  // Writing patterns (stored as JSON string)
  patternsJson    String   @default("{}")
  // Vocabulary (stored as JSON string)
  vocabularyJson  String   @default("{}")
  // Structure (stored as JSON string)
  structureJson   String   @default("{}")
  // Sample snippets
  sampleSnippets  String   @default("[]")
  // Metadata
  sourceCount     Int      @default(0)
  lastAnalyzedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([language])
}